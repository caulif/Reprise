# Personal project skills and generated architecture diagrams.
# Agents still load these from disk; they are local viewing only.
/.grok/
/.codex/skills/
/architecture.html
/architecture.md

# Operating system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and generated output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local protocol captures and experiment artifacts
.codex-app-server-schema/
.reprise*/
.playwright-cli/

# PPT flow local driver and tests. They must not live under test/ while ignored:
# verify:tracked-source rejects gitignored TypeScript in src/ and test/.
/scripts/ppt-flow-*.ts
/test/ppt-flow-*.test.ts

# One-shot notes accidentally created at the docs root.
/docs/真实使用测试记录-*.md
/docs/project-optimization-analysis-*.md

# Local interactive previews and exploratory research; durable conclusions belong in docs/plan or docs/decisions.
/docs/research/

# Local scratch output
/.tmp-*.txt
/.typecheck*
/.errors*

# User-specific historical verification runner
/scripts/codex-real-historical-c.mjs
/scripts/_live-run-with-env.py
/scripts/_validate-harness.mjs

# Documentation: only durable,规范性的材料受版本控制。
# 规则见 docs/documentation-structure.md「受控边界」一节。

# 一次性材料的本地保留区：已执行完毕的审查、被取代的计划、体验记录。
# 它们仍在磁盘上可查，但不进入 git，因此不会成为 review 噪音。
/docs/.local/
/docs/analysis/

# TUI 与验收产物：由脚本重新生成，不受控。
# 例外是 docs/tui-audit/frames/——它是 CI 比对的快照基线，必须受控。
/docs/tui-audit/*
!/docs/tui-audit/frames/
/docs/tui-full-flow/
/docs/tui-intake-review/
/docs/tui-live-run/
/docs/tui-loop/
/docs/evidence/

# Local scratch files
/scripts/tui-live-run.mjs
/test-output.txt
/pack-dry-run.json
/.tmp-jscpd/
/.tmp-test-output.txt

# One-shot source extraction leftovers
/scripts/extract-class-ops.mjs
/src/tui/controller-ops.ts
/src/tui/controller.ts.*.ts
/scripts/split-class-in-place.mjs
/src/tui/controller-state.ts
/scripts/alias-controller-imports.mjs
