{
  "entry": [
    "src/cli/main.ts!",
    "scripts/**/*.{ts,mjs}!",
    "test/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "test/**/*.ts"
  ],
  "ignore": [
    "dist/**",
    "docs/**",
    "scripts/codex-real-historical-c.mjs",
    "scripts/_live-run-with-env.py",
    "scripts/_validate-harness.mjs",
    "scripts/tui-live-run.mjs"
  ],
  "rules": {
    "exports": "error",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off"
  }
}
