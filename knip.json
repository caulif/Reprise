{
  "entry": [
    "scripts/**/*.{ts,mjs}!",
    "test/**/*.test.ts",
    "test/coverage-collector.ts!",
    "test/support/control-owner-child.ts!"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "test/**/*.ts"
  ],
  "ignore": [
    "src/application/recovery/run-forensics.ts",
    "src/application/recovery/run-model.ts",
    "src/application/recovery/staging.ts",
    "src/application/recovery/session.ts"
  ],
  "rules": {
    "exports": "error",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off"
  },
  "ignoreBinaries": [
    "where",
    "icacls.exe"
  ]
}
